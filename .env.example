DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:64322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:64321
# Copy the publishable key from `supabase status`.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional direct or session-pooler URL for Drizzle migrations.
# DATABASE_URL_UNPOOLED=
# Server root certificate in PEM format for hosted Supabase connections.
# SUPABASE_DB_CA_CERT=
# Connection pool size for the app (default 5). Set 1 behind a transaction pooler.
# DATABASE_POOL_MAX=5
# Postgres for `npm test`. Its schema is dropped and re-migrated on every run, so the
# database name must end in _test (the setup refuses anything else). It is created if missing.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:64322/cora_test

# --- Partner Connect demo ---
DEMO_MODE=true
# Fixed "now" for the demo so the business-day maths is reproducible.
DEMO_NOW=2026-11-20T09:14:00Z
APP_BASE_URL=http://localhost:3000

# Partner webhooks (HMAC-SHA256). Master key: each partner's secret is derived from it
# (`npm run partner:secret -- <slug>` prints the one to hand over), unless
# PARTNER_SECRET_<SLUG> sets that partner's secret explicitly.
PARTNER_WEBHOOK_SECRET=change-me-partner-secret

# ElevenLabs voice agent (leave empty to simulate the call)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# Shared secret the ElevenLabs server tools and the inbound-call webhook send in the
# x-tool-secret header (ElevenLabs workspace secret "cora_voice_tool_secret"). See docs/voice-agent.md.
VOICE_TOOL_SECRET=change-me-voice-secret
# Signing secret of the ElevenLabs post-call webhook (Settings -> Webhooks)
ELEVENLABS_WEBHOOK_SECRET=
# Optional workspace webhook ID for npm run voice:sync.
ELEVENLABS_POST_CALL_WEBHOOK_ID=
# Agent id for the voice widget in the tenant portal
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
# Number the demo calls (must be verified in Twilio on a trial account)
DEMO_TENANT_PHONE_OVERRIDE=

# WhatsApp Business Cloud API. See the WhatsApp agent section of README.md.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Use a separate, stable random secret for linking messages to tickets.
TICKETING_THREAD_SECRET=
# Optional Vercel AI Gateway model. Defaults to openai/gpt-5-mini.
# WHATSAPP_AI_MODEL=
# Optional when Vercel OIDC authentication is available.
# AI_GATEWAY_API_KEY=
