DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:64322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:64321
# Copy the publishable key from `supabase status`.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional direct or session-pooler URL for Drizzle migrations.
# DATABASE_URL_UNPOOLED=
# Server root certificate in PEM format for hosted Supabase connections.
# SUPABASE_DB_CA_CERT=

# WhatsApp Business Cloud API. See the WhatsApp agent section of README.md.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Optional Vercel AI Gateway model. Defaults to openai/gpt-5-mini.
# WHATSAPP_AI_MODEL=
# Optional when Vercel OIDC authentication is available.
# AI_GATEWAY_API_KEY=
