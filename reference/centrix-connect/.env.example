# --- Database ---
# Leave empty to use an embedded Postgres (PGlite) with auto-seeded demo data.
# Supabase: use the *transaction pooler* URL (port 6543).
DATABASE_URL=

# --- Demo ---
DEMO_MODE=true
# Optional fixed "now" for the demo, so business-day maths is reproducible.
DEMO_NOW=2026-11-20T09:14:00Z
APP_BASE_URL=http://localhost:3000

# --- Partner webhooks (HMAC-SHA256) ---
PARTNER_WEBHOOK_SECRET=change-me-partner-secret

# --- ElevenLabs voice agent ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# Shared secret the ElevenLabs server tool sends in the x-tool-secret header
VOICE_TOOL_SECRET=change-me-voice-secret
# Number the demo calls (must be verified in Twilio if on a trial account)
DEMO_TENANT_PHONE_OVERRIDE=
# Public agent id for the in-portal web widget fallback
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
